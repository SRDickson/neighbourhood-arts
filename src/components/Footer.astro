---
const currentYear = new Date().getFullYear();
---

<footer class="footer-dark">
  <div class="container-custom py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <h3 class="text-2xl font-medium mb-4" style="font-family: 'Playfair Display', serif;">
          Neighbourhood Arts
        </h3>
        <p class="text-gray-400 mb-6 max-w-md leading-relaxed">
          Supporting creative artists in Albert-Eden, Auckland to produce and promote
          arts and culture events in our community.
        </p>
        <div class="flex gap-4">
          <a
            href="https://www.facebook.com/neighbourhoodarts/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center border border-gray-600 text-gray-400 hover:text-white hover:border-white transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-6">Explore</h4>
        <ul class="space-y-3">
          <li>
            <a href="/about" class="text-gray-400 hover:text-white transition-colors">
              About Us
            </a>
          </li>
          <li>
            <a href="/projects" class="text-gray-400 hover:text-white transition-colors">
              Projects
            </a>
          </li>
          <li>
            <a href="/directory" class="text-gray-400 hover:text-white transition-colors">
              Artist Directory
            </a>
          </li>
          <li>
            <a href="/news" class="text-gray-400 hover:text-white transition-colors">
              News
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider mb-6">Contact</h4>
        <ul class="space-y-3 text-gray-400">
          <li>Albert-Eden, Auckland</li>
          <li>
            <a
              href="mailto:shona@neighbourhoodarts.org.nz"
              class="hover:text-white transition-colors"
            >
              shona@neighbourhoodarts.org.nz
            </a>
          </li>
          <li>
            <a href="tel:+64212558788" class="hover:text-white transition-colors">
              021 255 8788
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} Neighbourhood Arts. All rights reserved.
      </p>
      <img
        src="/images/albert-eden-logo.png"
        alt="Albert-Eden Local Board"
        class="h-16 w-auto"
      />
    </div>
  </div>
</footer>
