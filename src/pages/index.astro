---
import Layout from '../layouts/Layout.astro';

// Schema.org WebSite with SearchAction
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Neighbourhood Arts",
  "description": "Neighbourhood Arts (funded by the Albert-Eden Local Board) helps bring community-led arts projects to life across our diverse neighbourhoods in Auckland.",
  "url": "https://neighbourhoodarts.org.nz",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://neighbourhoodarts.org.nz/directory?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Albert-Eden",
    "addressRegion": "Auckland",
    "addressCountry": "NZ"
  }
};
---

<Layout
  title="Neighbourhood Arts | Albert-Eden Community Arts Auckland"
  description="Neighbourhood Arts (funded by the Albert-Eden Local Board) helps bring community-led arts projects to life across our diverse neighbourhoods in Auckland."
  keywords="neighbourhood arts, Albert-Eden, Auckland, community arts, local artists, musicians, visual artists, craft, art directory, community projects, Mt Albert, Sandringham, Kingsland, Albert-Eden Local Board"
  transparentHeader={true}
  schema={schema}
>

  <!-- Full-Screen Hero with Video Background -->
  <section class="hero-fullscreen">
    <!-- Video Background -->
    <div class="hero-video-container">
      <video autoplay muted loop playsinline>
        <source src="/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Overlay -->
    <div class="hero-overlay"></div>

    <!-- Content -->
    <div class="hero-content">
      <h1 class="hero-title sr-only">Neighbourhood Arts</h1>
      <p class="hero-subtitle text-4xl lg:text-6xl font-extrabold mb-10 tracking-tight uppercase" style="color: var(--color-secondary); text-shadow: 0 2px 20px rgba(0,0,0,0.8), 0 4px 40px rgba(0,0,0,0.5);">
        Building a vibrant, creative Albert-Eden - together.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/projects" class="btn-hero" aria-label="Explore community arts projects in Albert-Eden">
          Explore Projects
        </a>
        <a href="/about" class="btn-hero" aria-label="Learn more about Neighbourhood Arts and our community brokerage approach">
          Learn More
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="section-padding bg-cream">
    <div class="container-narrow text-center">
      <div class="divider divider-center"></div>
      <h2 class="section-title mb-6">Who We Are</h2>
      <p class="text-lg text-slate leading-relaxed max-w-2xl mx-auto">
        Neighbourhood Arts is a community arts brokering programme funded by the Albert-Eden Local Board. The arts broker supports local creatives and community groups to bring their projects to life in the community. This is achieved through dedicated local funding, project planning guidance and advice, along with connections to local spaces and opportunities. Through this, Neighbourhood Arts strengthens and celebrates Albert-Eden's creative identity and vibrant community spirit.
      </p>
      <a
        href="/about"
        class="inline-flex items-center gap-2 mt-8 text-primary font-medium hover:gap-3 transition-all"
        aria-label="Learn more about Neighbourhood Arts approach to community arts"
      >
        Learn more about our approach
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Where We Work -->
  <section class="section-padding bg-primary-dark text-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="divider" style="background-color: var(--color-secondary);"></div>
          <h2 class="section-title mb-6" style="color: white;">
            Where We Work
          </h2>
          <p class="text-lg text-gray-300 mb-8 leading-relaxed">
            We operate across the Albert-Eden area, bringing arts and culture to local
            communities. Our projects take place in community halls, libraries, parks,
            schools, and public spaces.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Balmoral</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Epsom</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Greenlane</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Kingsland</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Morningside</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Mt Albert</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Mt Eden</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Owairaka</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Pt Chevalier</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Sandringham</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-secondary rounded-full"></div>
              <span class="text-gray-200">Waterview</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <img
            src="/images/project-2.jpg"
            alt="Community gathering at arts event in Albert-Eden, Auckland showing diverse group enjoying local creative project"
            class="w-full aspect-[4/3] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/50 to-transparent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect Section -->
  <section class="section-padding bg-cream">
    <div class="container-narrow text-center">
      <div class="divider divider-center"></div>
      <h2 class="section-title mb-6">Get Involved</h2>
      <p class="text-lg text-slate leading-relaxed max-w-2xl mx-auto mb-10">
        Whether you're an artist looking for support, a venue wanting to host events,
        or a community member interested in the arts – we'd love to hear from you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/directory" class="btn-primary">
          Browse Directory
        </a>
        <a href="/about#contact" class="btn-primary" style="background: transparent; color: var(--color-primary);">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <!-- Supported By -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="text-center">
        <img
          src="/images/albert-eden-logo.png"
          alt="Albert-Eden Local Board"
          class="h-36 lg:h-44 mx-auto"
        />
      </div>
    </div>
  </section>

</Layout>
